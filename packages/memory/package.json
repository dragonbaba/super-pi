{
  "name": "@super-pi/memory",
  "version": "0.10.0-hardened.16",
  "description": "Persistent memory, session search, and secret scanning for Super Pi.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "src",
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --declaration false --sourceMap false",
    "check": "node scripts/ensure-dev.mjs check && tsc --noEmit && npm run build"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory",
    "persistent-memory",
    "session-search",
    "sqlite",
    "fts5",
    "skills",
    "agent",
    "hermes",
    "secret-scanning",
    "content-scanner",
    "memory-aging",
    "context-fencing",
    "two-tier-memory"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragonbaba/super-pi.git",
    "directory": "packages/memory"
  },
  "peerDependencies": {
    "@super-pi/ai": ">=0.84.0 <0.85.0",
    "@super-pi/coding-agent": ">=0.84.0 <0.85.0"
  },
  "devDependencies": {
    "@super-pi/ai": "^0.84.1",
    "@super-pi/coding-agent": "^0.84.1",
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "^4.21.0",
    "typebox": "^1.1.33",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@super-pi/tui": "^0.84.0",
    "better-sqlite3": "^12.9.0"
  }
}
