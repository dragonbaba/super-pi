{
	"name": "@super-pi/protocol",
	"version": "1.0.0",
	"description": "Transport-neutral CBOR protocol for remote Super Pi sessions",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"LICENSE-MIT",
		"NOTICE.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json"
	},
	"keywords": [
		"pi",
		"protocol",
		"cbor",
		"binary",
		"framing"
	],
	"author": "Earendil Works",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dragonbaba/super-pi.git",
		"directory": "packages/protocol"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"shx": "0.3.4"
	}
}
