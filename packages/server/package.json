{
	"name": "@super-pi/server",
	"version": "0.84.1",
	"description": "Experimental server package for Super Pi",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./unix": {
			"types": "./dist/transports/unix/index.d.ts",
			"import": "./dist/transports/unix/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"build": "tsgo -p tsconfig.build.json"
	},
	"keywords": [
		"pi",
		"server"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dragonbaba/super-pi.git",
		"directory": "packages/server"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@super-pi/ai": "^0.84.1",
		"@super-pi/protocol": "^0.84.1"
	},
	"devDependencies": {
		"shx": "0.4.0"
	}
}
