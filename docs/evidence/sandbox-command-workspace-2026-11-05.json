  "reproduction": {
    "baselineScript": "import fs from 'node:fs/promises';\nimport path from 'node:path';\nimport assert from 'node:assert/strict';\nimport {fileURLToPath} from 'node:url';\nimport {WorkspaceSandboxBackend} from '../../packages/coding-agent/src/core/sandbox/workspace-backend.ts';\nconst root=path.dirname(fileURLToPath(import.meta.url)), project=path.join(root,'project'), artifacts=path.join(root,'vms');\nawait fs.mkdir(project,{recursive:true});await fs.mkdir(artifacts,{recursive:true});\nawait fs.writeFile(path.join(project,'marker.txt'),'workspace-fixture\\n');\nconst backend=new WorkspaceSandboxBackend(project,artifacts,'sandbox-write',{network:'disabled'});\nlet vm;\ntry{\n const report=await backend.invoke('powershell',{command:\"[pscustomobject]@{cwd=(Get-Location).Path;relative=(Get-Content ./marker.txt -Raw).Trim();version=$PSVersionTable.PSVersion.ToString()} | ConvertTo-Json -Compress\",timeout:30});\n vm=backend.vm;console.log(report.text);\n assert.equal(JSON.parse(report.text).cwd,project);\n} finally {\n vm??=backend.vm;await backend.close();\n const record={diagnostics:backend.diagnostics,state:vm?.state,instanceId:vm?.id,calls:vm?.calls?.map(c=>({kind:c.kind,pid:c.pid,settled:!!c.result,exitCode:c.result?.exitCode}))};\n console.log(JSON.stringify(record));await fs.writeFile(path.join(root,'baseline-vm.json'),JSON.stringify(record,null,2));\n}\n",
    "packagedScript": "import fs from 'node:fs/promises';\nimport path from 'node:path';\nimport assert from 'node:assert/strict';\nimport {fileURLToPath} from 'node:url';\nimport {WorkspaceSandboxBackend} from '../../packages/coding-agent/dist/core/sandbox/workspace-backend.js';\nconst root=path.dirname(fileURLToPath(import.meta.url)),project=path.join(root,\"中文 space 'quote'\"),artifacts=path.join(root,'dist-vms');\nawait fs.mkdir(project,{recursive:true});await fs.mkdir(artifacts,{recursive:true});\nawait fs.writeFile(path.join(project,'marker.txt'),'fixture\\n');\nconst absolute=path.join(project,'marker.txt').replaceAll(\"'\",\"''\"),literal=project.replaceAll(\"'\",\"''\"),records=[];\nfor(const mode of ['read-only','sandbox-write']){\n const backend=new WorkspaceSandboxBackend(project,artifacts,mode,{network:'disabled'});let vm;\n const record={mode};\n try{\n  const result=await backend.invoke('powershell',{command:\"[pscustomobject]@{cwd=(Get-Location).Path;native=(node -p 'process.cwd()');relative=(Get-Content ./marker.txt -Raw).Trim();absolute=(Get-Content -LiteralPath '\"+absolute+\"' -Raw).Trim();version=$PSVersionTable.PSVersion.ToString()}|ConvertTo-Json -Compress\",timeout:30});\n  vm=backend.vm;Object.assign(record,JSON.parse(result.text));\n  assert.equal(record.cwd,project);assert.equal(record.native,project);assert.equal(record.absolute,'fixture');assert.equal(record.relative,'fixture');assert.match(record.version,/^7\\./);\n  assert.match((await backend.invoke('read',{path:path.join(project,'marker.txt')})).text,/fixture/);\n  if(mode==='read-only'){\n   const output=await backend.invoke('powershell',{command:\"$blocked=$false;try{[IO.File]::WriteAllText('\"+literal+\"\\\\forbidden.txt','no')}catch{$blocked=$true};[pscustomobject]@{blocked=$blocked}|ConvertTo-Json -Compress\",timeout:30});\n   record.writeBlocked=JSON.parse(output.text).blocked;assert.equal(record.writeBlocked,true);\n  }else{\n   const output=await backend.invoke('powershell',{command:\"[IO.File]::WriteAllText('\"+literal+\"\\\\created.txt','candidate');[IO.File]::WriteAllText((Join-Path $PWD 'relative.txt'),'relative')\",timeout:30});\n   assert.deepEqual(output.changes.map(c=>c.path).sort(),['created.txt','relative.txt']);\n   assert.equal(Buffer.from(output.changes.find(c=>c.path==='created.txt').content,'base64').toString(),'candidate');\n   record.candidatePaths=output.changes.map(c=>c.path);\n  }\n  assert.deepEqual(await fs.readdir(project),['marker.txt']);assert.equal(await fs.readFile(path.join(project,'marker.txt'),'utf8'),'fixture\\n');\n  record.hostUnchanged=true;\n }finally{\n  vm??=backend.vm;await backend.close();\n  record.cleanup={...backend.diagnostics,instanceId:vm?.id,state:vm?.state,calls:vm?.calls?.map(c=>({kind:c.kind,pid:c.pid,settled:!!c.result,exitCode:c.result?.exitCode,started:c.result?.spawnObservedUtc,finished:c.result?.closedUtc}))};\n  assert.equal(record.cleanup.vm,false);assert.equal(record.cleanup.sourceFiles,0);assert.equal(record.cleanup.ownedArtifacts,0);assert.equal(record.cleanup.state,'closed');\n  records.push(record);await fs.writeFile(path.join(root,'dist-acceptance.json'),JSON.stringify(records,null,2));console.log(JSON.stringify(record));\n }\n}\n",
    "runner": "import fs from 'node:fs';\nimport path from 'node:path';\nimport os from 'node:os';\nimport assert from 'node:assert/strict';\nimport {fileURLToPath} from 'node:url';\nimport {spawn} from 'node:child_process';\nconst root=path.dirname(fileURLToPath(import.meta.url));\nfor(const key of ['TMP','TEMP','TMPDIR'])assert.equal(path.resolve(process.env[key]),root);\nassert.equal(path.resolve(os.tmpdir()),root);\nconst manifestFile=path.join(root,'resources.json'),m=JSON.parse(fs.readFileSync(manifestFile,'utf8'));\nconst [label,exe,...args]=process.argv.slice(2);assert.ok(label&&exe);\nconst owner={pid:process.pid,role:'runner',label,started:new Date().toISOString(),settled:false};m.processes.push(owner);\nconst log=path.join(root,label+'.log');const fd=fs.openSync(log,'w');\nfunction seal(){const files=[root];for(let i=0;i<files.length;i++){const s=fs.lstatSync(files[i]);assert.ok(!s.isSymbolicLink());if(s.isDirectory())for(const name of fs.readdirSync(files[i]))files.push(path.join(files[i],name));}m.resources=files.map(file=>{const s=fs.lstatSync(file,{bigint:true});return {file,dev:String(s.dev),ino:String(s.ino),directory:s.isDirectory()};});fs.writeFileSync(manifestFile,JSON.stringify(m,null,2));}\nconst home=path.join(root,'home');fs.mkdirSync(home,{recursive:true});\nconst child=spawn(exe,args,{cwd:'D:/RMProjects/Pi',env:{...process.env,HOME:home,USERPROFILE:home,SP_CODING_AGENT_DIR:path.join(root,'agent'),SP_CODING_AGENT_SESSION_DIR:path.join(root,'sessions'),XDG_CONFIG_HOME:path.join(root,'xdg'),npm_config_cache:path.join(root,'npm-cache'),PYTHONDONTWRITEBYTECODE:'1'},windowsHide:true,stdio:['ignore',fd,fd]});\nconst record={pid:child.pid,label,executable:exe,args,started:new Date().toISOString(),settled:false};m.processes.push(record);seal();\nlet failure;\nchild.on('error',error=>{failure=String(error);});\nchild.on('close',(code,signal)=>{fs.closeSync(fd);Object.assign(record,{code,signal,failure,settled:true,finished:new Date().toISOString()});Object.assign(owner,{settled:true,finished:new Date().toISOString()});m.processes=JSON.parse(fs.readFileSync(manifestFile,'utf8')).processes;for(const update of [record,owner]){const saved=m.processes.find(p=>p.pid===update.pid&&p.started===update.started);assert.ok(saved);Object.assign(saved,update);}seal();console.log(JSON.stringify({...record,log}));process.exitCode=code??1;});\n\n\r\n",
