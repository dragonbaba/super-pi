    "runner": "import fs from 'node:fs';\nimport path from 'node:path';\nimport os from 'node:os';\nimport assert from 'node:assert/strict';\nimport {fileURLToPath} from 'node:url';\nimport {spawn} from 'node:child_process';\nconst root=path.dirname(fileURLToPath(import.meta.url));\nfor(const key of ['TMP','TEMP','TMPDIR'])assert.equal(path.resolve(process.env[key]),root);\nassert.equal(path.resolve(os.tmpdir()),root);\nconst manifestFile=path.join(root,'resources.json'),m=JSON.parse(fs.readFileSync(manifestFile,'utf8'));\nconst [label,exe,...args]=process.argv.slice(2);assert.ok(label&&exe);\nconst owner={pid:process.pid,role:'runner',label,started:new Date().toISOString(),settled:false};m.processes.push(owner);\nconst log=path.join(root,label+'.log');const fd=fs.openSync(log,'w');\nfunction seal(){const files=[root];for(let i=0;i<files.length;i++){const s=fs.lstatSync(files[i]);assert.ok(!s.isSymbolicLink());if(s.isDirectory())for(const name of fs.readdirSync(files[i]))files.push(path.join(files[i],name));}m.resources=files.map(file=>{const s=fs.lstatSync(file,{bigint:true});return {file,dev:String(s.dev),ino:String(s.ino),directory:s.isDirectory()};});fs.writeFileSync(manifestFile,JSON.stringify(m,null,2));}\nconst home=path.join(root,'home');fs.mkdirSync(home,{recursive:true});\nconst child=spawn(exe,args,{cwd:'D:/RMProjects/Pi',env:{...process.env,HOME:home,USERPROFILE:home,SP_CODING_AGENT_DIR:path.join(root,'agent'),SP_CODING_AGENT_SESSION_DIR:path.join(root,'sessions'),XDG_CONFIG_HOME:path.join(root,'xdg'),npm_config_cache:path.join(root,'npm-cache'),PYTHONDONTWRITEBYTECODE:'1'},windowsHide:true,stdio:['ignore',fd,fd]});\nconst record={pid:child.pid,label,executable:exe,args,started:new Date().toISOString(),settled:false};m.processes.push(record);seal();\nlet failure;\nchild.on('error',error=>{failure=String(error);});\nchild.on('close',(code,signal)=>{fs.closeSync(fd);Object.assign(record,{code,signal,failure,settled:true,finished:new Date().toISOString()});Object.assign(owner,{settled:true,finished:new Date().toISOString()});m.processes=JSON.parse(fs.readFileSync(manifestFile,'utf8')).processes;for(const update of [record,owner]){const saved=m.processes.find(p=>p.pid===update.pid&&p.started===update.started);assert.ok(saved);Object.assign(saved,update);}seal();console.log(JSON.stringify({...record,log}));process.exitCode=code??1;});\n\n",
