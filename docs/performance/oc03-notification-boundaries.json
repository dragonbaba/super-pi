  "scope": {
    "productionChange": "AgentSession.sendCustomMessage constructs its existing appMessage before waiting for a prior idle custom drain. A rejected wait queues that same unconsumed object if the owner is still valid, then throws the original error.",
    "unchanged": [
      "TaskHistory persistence/recovery",
      "shell and subagent execution",
      "ordinary provider/message/tool progress delivery",
      "permission gates",
      "Codemode",
      "cross-restart notification policy"
    ],
    "auditChain": [
      "subagent TaskManager.finish / TaskHistory.save terminal transaction",
      "shell BackgroundShellTasks.run and subagent complete -> pi.sendMessage with generation/authority gates",
      "extension loader API invalidation and AgentSession runtime adapter (fire-and-forget errors observed)",
      "AgentSession.sendCustomMessage -> _flushPendingCustomMessages -> _drainPendingCustomMessages -> _appendCustomMessage",
      "SessionManager.appendCustomMessageEntry; explicit prompt flush before provider request",
      "Agent latest observer -> snapshot -> AgentSession -> InteractiveMode; settlement, waitForIdle and dispose"
    ],
    "exactLifecycleBoundaries": [
      "AgentSession.sendCustomMessage (explicit custom notification ingestion, existing async method and one appMessage)",
      "AgentSession._flushPendingCustomMessages / _drainPendingCustomMessages (one shared drain owner; existing async lifecycle)",
      "AgentSession._appendCustomMessage (existing hook and persistence boundary)"
    ],
    "allocationAudit": "The changed catch pushes the already-created appMessage into the existing array. No new closure, Promise constructor, AbortController, timer, deferred, Promise tail/array, wrapper, storage write, or object pool. The existing async call and appMessage are not claimed allocation-free.",
    "ownership": "AgentSession owns pending custom messages and one drain Promise. Successful draining consumes queued reports; drain finally removes the consumed prefix and clears the Promise; dispose clears pending arrays and the guarded waiter cannot refill a disposed owner. Until explicit consumption/disposal, failed-wait reports remain intentionally reachable.",
    "capacity": "The existing general custom-message queue has no global cardinality/byte hard limit. This is not a new bounded outbox. Managed task completion reports separately retain their existing 8-entry/8192 UTF-16-unit limit; persisted task history has its existing 512-row limit.",
    "nonGuarantees": [
      "SDK rejection does not prove zero local acceptance; callers must not blindly resend.",
      "No automatic retry, cross-restart notification replay, automatic execution recovery, or end-to-end exactly-once guarantee.",
      "A persisted context entry does not prove that a model processed it or that an external side effect may be replayed."
    ]
  },
  "reproduction": {
    "command": "node --experimental-strip-types --test --test-name-pattern='failed shared drain' tests/custom-message-ordering.test.ts",
    "before": "Context-only send retained one report; triggerTurn send retained zero (assertion expected one).",
    "after": "Both retain the report while rejecting with the original error; failure issues zero model requests. Explicit recovery saves the report once and the next provider payload contains it once. Disposed waiter leaves pending length zero."
