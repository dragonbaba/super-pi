{
	"name": "super-pi-monorepo",
	"description": "Super Pi source monorepo and local superpi CLI",
	"private": true,
	"type": "module",
	"license": "MIT",
	"repository": "https://github.com/dragonbaba/super-pi",
	"bin": {
		"superpi": "./scripts/superpi.mjs"
	},
	"workspaces": [
		"packages/*",
		"packages/extensions/*",
		"packages/session-backends/*"
	],
	"scripts": {
		"superpi": "node ./scripts/superpi.mjs",
		"test:unit": "node ./scripts/test.mjs --suite unit",
		"test:hot": "node ./scripts/test.mjs --suite hot",
		"test:contract": "node ./scripts/test.mjs --suite contract",
		"test": "node ./scripts/test.mjs --suite all",
		"verify": "npm run check && npm run build:offline && npm test",
		"bench:stream": "node --experimental-strip-types ./scripts/bench/stream-events.ts",
		"bench:tool-progress": "node --experimental-strip-types ./scripts/bench/tool-progress.ts",
		"bench:tui-transcript": "node --experimental-strip-types ./scripts/bench/tui-transcript.ts",
		"bench:tui-retained-lifecycle": "node --expose-gc --experimental-strip-types ./scripts/bench/tui-retained-lifecycle.ts",
		"bench:tui-frame-allocations": "node --expose-gc --experimental-strip-types ./scripts/bench/tui-frame-allocations.ts",
		"bench:tui-frame-queue": "node --experimental-strip-types ./scripts/bench/tui-frame-queue.ts",
		"bench:prefix": "node --experimental-strip-types ./scripts/bench/prefix-build.ts",
		"bench:effective-dispatch": "node --experimental-strip-types ./scripts/bench/effective-dispatch.ts",
		"bench:cache-markers": "node --experimental-strip-types ./scripts/bench/cache-marker-extraction.ts",
		"bench:model-runtime": "node --experimental-strip-types ./scripts/bench/model-runtime-startup.ts --mode cold",
		"bench:model-runtime:warm": "node --experimental-strip-types ./scripts/bench/model-runtime-startup.ts --mode warm",
		"bench:model-catalog-restore": "node --experimental-strip-types ./scripts/bench/model-catalog-restore.ts",
		"bench:tool-output": "node --experimental-strip-types ./scripts/bench/tool-output.ts",
		"bench:compare": "node --experimental-strip-types ./scripts/bench/compare.ts",
		"clean": "npm run clean --workspaces --if-present",
		"build": "cd packages/tui && npm run build && cd ../telemetry && npm run build && cd ../ai && npm run build && cd ../agent && npm run build && cd ../session-backends/sqlite-node && npm run build && cd ../../protocol && npm run build && cd ../client && npm run build && cd ../server && npm run build && cd ../coding-agent && npm run build && cd ../memory && npm run build && cd ../statusline && npm run build",
		"build:offline": "cd packages/tui && npm run build && cd ../telemetry && npm run build && cd ../ai && npm run build:offline && cd ../agent && npm run build && cd ../session-backends/sqlite-node && npm run build && cd ../../protocol && npm run build && cd ../client && npm run build && cd ../server && npm run build && cd ../coding-agent && npm run build && cd ../memory && npm run build && cd ../statusline && npm run build",
		"check": "tsgo --noEmit"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"shx": "0.4.0",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.0.3",
	"overrides": {
		"protobufjs": "7.6.5",
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	},
	"allowScripts": {
		"better-sqlite3@12.11.1": true,
		"canvas@3.2.3": true,
		"esbuild@0.28.1": true,
		"protobufjs@7.6.5": true,
		"@google/genai@1.52.0": true
	}
}
